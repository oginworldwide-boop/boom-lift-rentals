---
import '../styles/global.css';
import { graph } from '../schema';

interface Props {
  title: string;
  description: string;
  /** Path to the page's 1200x630 JPEG share image from `npm run og`, e.g. "/og/jlg-1350sjp.jpg".
   *  Made absolute below. Not WebP: WhatsApp previews are unreliable with it. */
  ogImage?: string;
  ogImageAlt?: string;
  /** The page's LCP image (home: HERO_IMG from Hero.tsx). Preloaded from <head> with the
   *  img's exact srcset/sizes, so the browser dedupes it with React's in-body preload. */
  preloadImage?: { src: string; srcSet: string; sizes: string };
  /** JSON-LD nodes for this page, wrapped in an @graph below. */
  schema?: object[];
  /** For pages that must not be indexed (404, thank-you). Emits robots noindex and
   *  drops canonical and og:url, since there is no canonical URL to point at. */
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/og/home.jpg',
  ogImageAlt = 'OG-IN Worldwide boom lift rental',
  preloadImage,
  schema = [],
  noindex = false,
} = Astro.props;

// Astro.site comes from astro.config.mjs. Building canonical and OG URLs from it
// keeps them consistent with the sitemap and with the trailingSlash policy, rather
// than having three places that each guess at the origin.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

const SITE_NAME = 'OG-IN Worldwide LLP';

const jsonLd = schema.length ? graph(schema) : null;

// GA4. Set PUBLIC_GA4_ID (e.g. G-XXXXXXXXXX) in the build environment (Netlify UI)
// to load gtag.js and send click_call, click_whatsapp and, on /quote/thanks/,
// generate_lead. Unset, the site ships no JavaScript at all. scripts/assert-html.mjs
// reads the same variable and allows these two scripts and nothing else.
const ga4Id: string | undefined = import.meta.env.PUBLIC_GA4_ID;
if (ga4Id && !/^G-[A-Z0-9]+$/.test(ga4Id)) throw new Error(`PUBLIC_GA4_ID "${ga4Id}" is not a GA4 measurement ID`);
const ga4Script = ga4Id && [
  'window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}',
  `gtag('js',new Date());gtag('config','${ga4Id}');`,
  // One delegated listener: every tel: and wa.me link on the page, including ones added later.
  `document.addEventListener('click',function(e){var a=e.target.closest&&e.target.closest('a[href^="tel:"],a[href^="https://wa.me/"]');if(a)gtag('event',a.protocol==='tel:'?'click_call':'click_whatsapp',{link_url:a.href})});`,
  // Only a real submission counts: the form POST arrives from a page on this origin
  // (a bookmark, share or direct visit has no same-origin referrer), and a reload
  // keeps that referrer, so a sessionStorage flag stops a second count. Storage
  // blocked: the lead still fires (ponytail: reloads can then double-count).
  Astro.url.pathname === '/quote/thanks/'
    ? `if(document.referrer.indexOf(location.origin+'/')===0){var s;try{s=sessionStorage.getItem('og_lead');sessionStorage.setItem('og_lead','1')}catch(e){}if(!s)gtag('event','generate_lead')}`
    : '',
].join('');
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0d1117" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_IN" />

    <!-- Enquiries travel over WhatsApp, which reads these tags for its link preview.
         Images are 1200x630 JPEGs under 150 KB with the subject in the centre square,
         since WhatsApp often crops to a square. Regenerate with `npm run og`. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {/* React 19 also emits a preload for a fetchPriority="high" <img>, but in <body>,
        after this head has been parsed. This one starts the LCP fetch earlier; identical
        imagesrcset/imagesizes let the browser treat both as the same request. */}
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage.src} imagesrcset={preloadImage.srcSet} imagesizes={preloadImage.sizes} fetchpriority="high" />
    )}

    <!-- Display font only (headings, numerals). Self-hosted, swap; body text is system UI. -->
    <link rel="preload" href="/fonts/barlow-condensed-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    {ga4Id && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>}
    {ga4Script && <script is:inline set:html={ga4Script} />}
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="bg-paper font-sans text-ink antialiased">
    <slot />
  </body>
</html>
