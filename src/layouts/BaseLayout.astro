---
import '../styles/global.css';
import { graph } from '../schema';

interface Props {
  title: string;
  description: string;
  /** Path to the page's 1200x630 JPEG share image from `npm run og`, e.g. "/og/jlg-1350sjp.jpg".
   *  Made absolute below. Not WebP: WhatsApp previews are unreliable with it. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'product';
  /** JSON-LD nodes for this page, wrapped in an @graph below. */
  schema?: object[];
  /** For pages that must not be indexed (404, thank-you). Emits robots noindex and
   *  drops canonical and og:url, since there is no canonical URL to point at. */
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/og/home.jpg',
  ogImageAlt = 'OG-IN Worldwide boom lift rental',
  ogType = 'website',
  schema = [],
  noindex = false,
} = Astro.props;

// Astro.site comes from astro.config.mjs. Building canonical and OG URLs from it
// keeps them consistent with the sitemap and with the trailingSlash policy, rather
// than having three places that each guess at the origin.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

const SITE_NAME = 'OG-IN Worldwide LLP';

const jsonLd = schema.length ? graph(schema) : null;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0d1117" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_IN" />

    <!-- Enquiries travel over WhatsApp, which reads these tags for its link preview.
         Images are 1200x630 JPEGs under 150 KB with the subject in the centre square,
         since WhatsApp often crops to a square. Regenerate with `npm run og`. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {/* No hero preload here: React 19 already emits <link rel="preload" as="image">
        for the fetchPriority="high" hero <img> (and for each machine page's image),
        so a second one would only duplicate it. */}

    <!-- Display font only (headings, numerals). Self-hosted, swap; body text is system UI. -->
    <link rel="preload" href="/fonts/barlow-condensed-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="bg-paper font-sans text-ink antialiased">
    <slot />
  </body>
</html>
