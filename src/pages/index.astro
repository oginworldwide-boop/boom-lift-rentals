---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteShell from '../components/SiteShell';
import HomeSections from '../components/HomeSections';
import { HERO_IMG } from '../components/Hero';
import { localBusiness, webSite } from '../schema';
import { HOME_TITLE, HOME_DESCRIPTION } from '../seo';
---
<BaseLayout
  schema={[localBusiness(Astro.site!), webSite(Astro.site!)]}
  title={HOME_TITLE}
  description={HOME_DESCRIPTION}
  preloadImage={HERO_IMG}
>
  <SiteShell path={Astro.url.pathname} quoteHref="#quote"><HomeSections /></SiteShell>
</BaseLayout>
