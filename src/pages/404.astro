---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteShell from '../components/SiteShell';
import { BOOM_LIFTS } from '../../constants';
import { liftPath } from '../seo';
---
<BaseLayout noindex title="Page not found | OG-IN Worldwide" description="This page does not exist. Go to the home page or the boom lift fleet.">
  <SiteShell>
    <section class="max-w-3xl mx-auto px-4 pt-28 pb-24">
      <h1 class="text-3xl font-bold text-slate-900 mb-4">Page not found</h1>
      <p class="mb-6">
        <a href="/" class="underline mr-6">Home</a>
        <a href="/fleet/" class="underline">Fleet</a>
      </p>
      <ul class="space-y-1">
        {BOOM_LIFTS.map((l) => (
          <li><a href={liftPath(l)} class="underline">{l.brand} {l.model}</a></li>
        ))}
      </ul>
    </section>
  </SiteShell>
</BaseLayout>
