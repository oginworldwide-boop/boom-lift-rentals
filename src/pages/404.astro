---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteShell from '../components/SiteShell';
import { FleetGrid } from '../components/LiftCard';
import { BTN_LINE_DARK, BTN_PRIMARY, CONTAINER } from '../components/ui';
---
<BaseLayout noindex title="Page not found | OG-IN Worldwide" description="This page does not exist. Go to the home page or the boom lift fleet.">
  <SiteShell path={Astro.url.pathname}>
    <div class="bg-ink py-12 text-white sm:py-16">
      <div class={CONTAINER}>
        <h1 class="font-display text-[2.5rem] leading-[1.02] sm:text-[3.5rem]">Page not found</h1>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/" class={BTN_LINE_DARK}>Home</a>
          <a href="/fleet/" class={BTN_PRIMARY}>Fleet</a>
        </div>
      </div>
    </div>
    <section class={`${CONTAINER} py-12`}>
      <FleetGrid />
    </section>
  </SiteShell>
</BaseLayout>
